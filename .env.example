# Porta do servidor
PORT=3000
# STUN (padrão: servidores públicos do Google)
# STUN_URLS=stun:stun.l.google.com:19302
# TURN (necessário para redes 4G/corporativas restritas). Use coturn próprio ou provedor.
# TURN_URLS=turn:turn.seudominio.com:3478,turns:turn.seudominio.com:5349
# Opção A (recomendada): segredo compartilhado com o coturn (use-auth-secret) -> credenciais temporárias
# TURN_SECRET=troque-este-segredo
# Opção B: usuário/senha fixos
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha
# Celular/chip: segredo que assina os números dos chips (qualquer texto longo). Sem ele, é criado o arquivo .phone-secret.
# Em hospedagem sem disco permanente (Render grátis etc.) DEFINA, senão os chips deixam de valer quando o servidor reinicia.
# PHONE_SECRET=troque-por-um-texto-longo-e-aleatorio

# Contas: pasta onde ficam as contas e o progresso (use um disco PERMANENTE na hospedagem)
# DATA_DIR=/data
